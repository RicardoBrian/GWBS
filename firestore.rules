rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 현재 설정: 읽기/쓰기 모두 허용 (기존 GAS 앱과 동일한 보안 수준)
    // 추후 Firebase Auth 도입 시 아래 주석 처리된 규칙으로 교체 권장
    match /{document=**} {
      allow read, write: if true;
    }

    // --- 강화된 보안 규칙 (선택사항) ---
    // match /broadcasts/{doc} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
    // match /attendance/{doc} {
    //   allow read, write: if true;
    // }
    // match /songs/{doc} {
    //   allow read, write: if true;
    // }
    // match /manuals/{doc} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
  }
}
