rules_version = '2';

// 관산중학교 방송부 앱 — Firestore 보안 규칙
//
// ⚠️ 이 파일을 저장소에 두는 것만으로는 아무 효과가 없습니다.
//    반드시 Firebase에 "게시(deploy)"해야 적용됩니다.
//      · CLI:  firebase deploy --only firestore:rules
//      · 콘솔: Firebase 콘솔 → Firestore Database → 규칙 → 붙여넣기 → 게시
//
// 읽기는 공개, 쓰기는 두 종류의 신원 중 하나가 있어야 합니다.
//   · staff — 사이트 입장 비밀번호(Cloudflare SITE_PASSWORD)를 통과함.
//             Cloudflare Function(functions/_middleware.js)이 발급하는
//             Firebase 커스텀 토큰의 staff:true 클레임으로 판단합니다.
//             (익명 로그인은 공개 API 키만 있으면 누구나 되므로 쓰지 않습니다)
//   · admin — 관리자 페이지에서 구글 계정으로 직접 로그인함(Firebase Auth).
//             허용된 이메일 1개만 인정합니다. Cloud Function이나 커스텀
//             클레임 없이, 구글이 서명한 ID 토큰의 email 클레임을 그대로
//             검사합니다 — Google Sign-In은 email_verified 를 항상 true 로
//             채우므로 이 값을 신뢰할 수 있습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function staff() {
      return request.auth != null && request.auth.token.staff == true;
    }
    function admin() {
      return request.auth != null
          && request.auth.token.email == 'qjatjr7575@gmail.com'
          && request.auth.token.email_verified == true;
    }
    function canEdit() { return staff() || admin(); }

    // 연결 진단용 프로브 (fb-guard.js). 읽기만 허용, 실제 문서는 없음.
    match /__health/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /broadcasts/{doc} { allow read: if true; allow write: if canEdit(); }
    match /students/{doc}   { allow read: if true; allow write: if canEdit(); }
    match /attendance/{doc} { allow read: if true; allow write: if canEdit(); }
    match /manuals/{doc}    { allow read: if true; allow write: if canEdit(); }

    // 앱 설정은 관리자(구글 로그인)만
    match /settings/{doc}   { allow read: if true; allow write: if admin(); }

    // 신청곡: 학생이 신청 페이지에서 직접 만드는 유일한 문서.
    // 만들기는 공개지만, 형식을 검사해 장난성 대량 등록을 막습니다.
    match /songs/{doc} {
      allow read: if true;
      allow create: if isSongRequest();
      allow update, delete: if canEdit();
    }

    function isSongRequest() {
      let d = request.resource.data;
      return d.song is string && d.song.size() > 0 && d.song.size() <= 100
          && d.name is string && d.name.size() <= 20
          && (!('artist' in d) || (d.artist is string && d.artist.size() <= 60))
          && (!('grade' in d) || (d.grade is string && d.grade.size() <= 10))
          && (!('classInfo' in d) || (d.classInfo is string && d.classInfo.size() <= 20))
          && d.isDone == false
          && !('videoId' in d);   // 영상 연결은 방송부만
    }

    // 위에 명시하지 않은 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
